filters:
  and:
    - type == "book"
    - file.inFolder("50-garden/ru/library")
formulas:
  score: 'if(demand, 4, 0) + if(want, want, 2) * 2 + if(chunks, 1, 0)'
properties:
  formula.score:
    displayName: Счёт
  want:
    displayName: Хочется
  demand:
    displayName: Спрос сейчас
  chunks:
    displayName: Членится
  file.name:
    displayName: Книга
  author:
    displayName: Автор
  year:
    displayName: Год
  category:
    displayName: Раздел
  status:
    displayName: Статус
  plan:
    displayName: Зачем
  queue:
    displayName: Очередь
views:
  - type: table
    name: Список
    order:
      - file.name
      - author
      - year
      - category
      - status
      - plan
      - queue
    sort:
      - property: status
        direction: ASC
      - property: queue
        direction: ASC
  - type: table
    name: Что читать дальше
    filters:
      and:
        - status != "done"
    order:
      - file.name
      - formula.score
      - want
      - demand
      - chunks
      - plan
      - author
    sort:
      - property: formula.score
        direction: DESC
    limit: 3
  - type: table
    name: Очередь
    filters:
      and:
        - status != "done"
    order:
      - file.name
      - formula.score
      - want
      - demand
      - chunks
      - plan
      - author
    sort:
      - property: formula.score
        direction: DESC
  - type: cards
    name: Обложки
    order:
      - file.name
      - author
      - status
    image: note.cover
